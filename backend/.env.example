# HTTP port for the Express API.
PORT=4000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# File-backed SQLite production database path.
DATABASE_PATH=./data/bookmyshow.db
# Separate file-backed SQLite path used by automated tests when needed.
TEST_DATABASE_PATH=./data/bookmyshow.test.db
# JWT signing secret; replace before deploying.
JWT_SECRET=dev-secret-change-in-production
# Test-only delay for catalogue responses in milliseconds; leave at zero outside Playwright.
TEST_CATALOG_DELAY_MS=0
# Test-only seeded movie ID that returns no theatres; omit outside Playwright.
TEST_EMPTY_THEATRES_MOVIE_ID=0
